# Railway → Variables. Only JWT_SECRET is required.
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
# Only if you attach a Volume so orders/accounts survive redeploys (mount it at /data):
# DB_PATH=/data/bps.db
# Only if you ever host the frontend on a different domain (not needed for the one-service setup):
# CLIENT_ORIGIN=https://your-frontend.example.com
